<Window x:Class="JournalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JournalApp"

        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock 
            Grid.Row ="0"
            Margin="10, 5"
            Text="Journal App"
            HorizontalAlignment="Center"
        />
        <Grid 
            Grid.Row="0"
            HorizontalAlignment="Right"
        >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="5" Click="JournalExplorer_Click">
                Journal Explorer
            </Button>
            <Button Grid.Column="1" Margin="5" Click="NewEntry_Click">
                New Entry
            </Button>
            <Button Grid.Column="2" Margin="5" Click="History_Click">
                History View
            </Button>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                x:Name="SidebarColumn"
                Width="300"
                MinWidth="180"
            />
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl
                x:Name="SidebarContent"
                Grid.Column="0"/>
            <GridSplitter Grid.Column="1"
                            Width="5"
                            HorizontalAlignment="Stretch"
                            ResizeDirection="Columns"/>
            <ContentControl x:Name="MainContent"
                            Grid.Column="2"/>
        </Grid>
    </Grid>
</Window>
